# Zeek 8.0 plus the packages the S5 decision (#1727 §0) commits to:
# JA4+ for the fingerprint families, HASSH for SSH, and the ICSNPP parsers for
# the OT surface we expose but currently cannot read.
#
# Same package set as vps/zeek, deliberately: what the lab measures is only
# evidence for production if production runs the same parsers -- same base
# digest, same pins, mirrored line for line (scripts/check-zeek-pin-parity.py
# fails CI when the two files disagree).
#
# ICSNPP's parsers are Spicy/C++ plugins, so this build compiles rather than
# just copies -- expect ~10 minutes. That cost is paid once, locally, and never
# on the VPS: this image exists for the development harness only.
#
# Base pinned by manifest-list digest per docs/CONTAINER-UPDATES.md, resolved
# 2026-08-27 to what :8.0 pointed at that day (#2456) -- the same digest
# vps/zeek/Containerfile carries. The list digest covers amd64 and arm64
# alike, so lab and prod land on identical base bits however each host pulls.
FROM docker.io/zeek/zeek:8.0@sha256:73e80e9cd23ff71fd28d158e9a9af5c7b2b0ef5d4036af61521827531347c0e3

# /usr/local/zeek is where the official image installs; /opt/zeek is the
# source-build location and does not exist here.
ENV PATH="/usr/local/zeek/bin:${PATH}" \
    DEBIAN_FRONTEND=noninteractive

# The official Zeek image ships the runtime, not a toolchain, so every package
# with a compiled plugin fails to install. Two distinct failures, both hit
# while building this:
#   1. no CMake at all — "This plugin requires CMake, please install it first."
#   2. with CMake present, ZeekPlugin.cmake's own find_dependency(OpenSSL)
#      fails — "Could NOT find OpenSSL ... (missing: OPENSSL_CRYPTO_LIBRARY
#      OPENSSL_INCLUDE_DIR)". Zeek links OpenSSL but the image carries only
#      the runtime library, not the headers.
# JA4 additionally wants a C++20 compiler; the trixie base ships GCC 14.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        cmake g++ make git python3-dev libpcap-dev libssl-dev && \
    rm -rf /var/lib/apt/lists/*

# zkg needs a writable state dir and a non-interactive config before it will
# install anything.
RUN zkg autoconfig --force

# --- Fingerprinting ------------------------------------------------------
# JA4+ gives JA4/JA4S (ssl.log), JA4H (http.log), JA4SSH (ja4ssh.log),
# JA4T/JA4TS/JA4L/JA4LS (conn.log) and JA4X (x509.log). Only JA4 itself is
# BSD-3; the rest are FoxIO License 1.1, which permits internal security use
# and non-commercial research and forbids monetization. APIARY qualifies --
# recorded here so the constraint travels with the image.
#
# Pinned for the same reason as the hassh block below (#2456): --version
# resolves to what prod's 2026-08-23 build had already shipped, read back out
# of the running sensor's zkg state -- the v1.0.0 tag commit (2026-08-14).
# main has moved past it since; refreshing is a deliberate
# docs/CONTAINER-UPDATES.md bump, not something a rebuild absorbs silently.
RUN zkg install --force --skiptests --version 4ce66bbc50d52e47825133e99fd8869d0b8a941a \
        zeek/foxio/ja4

# HASSH fingerprints the SSH handshake's algorithm lists, which the attacker
# cannot trivially forge -- unlike the banner string that is currently our only
# SSH client signal.
#
# Installed by git URL, not index name: the package is indexed under corelight
# rather than its own repo owner, so the obvious "zeek/salesforce/hassh" is
# "package name not found in sources". The repo carries a root zkg.meta, so
# the URL form is unambiguous and does not depend on index naming.
#
# Same pin as vps/zeek (#1821, mirrored by #2456): salesforce/hassh is
# archived, and 56fa496 (2025-05-01, titled "This repo is ARCHIVED") is the
# last state the package will ever have. The lab does not apply prod's
# hassh_optional_patch.py -- on this Zeek 8.0 base the &default/&optional
# collision is still only a warning -- so the only lab/prod hassh difference
# is that patch, not the vendored commit.
RUN zkg install --force --skiptests --version 56fa496af4495ce890ea790a0152215520fc3b7a \
        https://github.com/salesforce/hassh

# --- ICS / OT ------------------------------------------------------------
# One parser per ICS port portbridge already forwards:
#   102   S7comm/COTP        502   Modbus        2404  IEC-104 (no parser yet)
#   20000 DNP3               44818 EtherNet/IP   47808 BACnet
# Installed individually rather than as a metapackage so a single upstream
# breakage is obvious instead of taking the whole ICS surface down with it,
# and by git URL rather than index name because the index names do not always
# match the repo names -- the Profinet parser is indexed as
# "icsnpp-profinet-io-cm", and plain "icsnpp-profinet" is a 404.
#
# Every parser is pinned (--version) to what prod's 2026-08-23 build actually
# shipped, read back out of the running sensor's zkg clones (#2456) -- the
# identical table vps/zeek/Containerfile carries. Building this file now
# reproduces prod's parser commits instead of resolving whatever main moved
# to since the last rebuild; one --version applies to a whole zkg invocation,
# so each parser gets its own call.
#
#   modbus          16428919  v2.0.0 tag (2025-09-03); main has since moved
#                             to 27f22b41 (2026-08-05) -- taking it is a
#                             deliberate docs/CONTAINER-UPDATES.md bump
#   dnp3            b31dbade  main tip at pin time
#   enip            9ad78fbe  main tip at pin time
#   bacnet          b34b92eb  main tip at pin time
#   s7comm          7ebeb03a  main tip at pin time
#   opcua-binary    efca88a3  v2.0.0 tag (2025-07-09); main has since moved
#                             to 926c08a (2026-08-24) -- taking it is a
#                             deliberate docs/CONTAINER-UPDATES.md bump
#   profinet-io-cm  833a78c0  main tip at pin time
#
# scripts/check-zeek-pin-parity.py fails CI when the two files disagree.
RUN zkg install --force --skiptests --version 16428919f5efb034eda625bf989c68543e2a5e76 \
        https://github.com/cisagov/icsnpp-modbus && \
    zkg install --force --skiptests --version b31dbadeceb1cbcda16aef89c650559cd177dd7e \
        https://github.com/cisagov/icsnpp-dnp3 && \
    zkg install --force --skiptests --version 9ad78fbe11127f152a1c5c5f97ba4c8e48cc8fea \
        https://github.com/cisagov/icsnpp-enip && \
    zkg install --force --skiptests --version b34b92eb2a82848e55748fc57036a624368b1d4f \
        https://github.com/cisagov/icsnpp-bacnet
RUN zkg install --force --skiptests --version 7ebeb03a0f954541369361651d1c27d09a64b5a3 \
        https://github.com/cisagov/icsnpp-s7comm && \
    zkg install --force --skiptests --version efca88a3f65c58ad496588aba8e9dfe79d9f92a1 \
        https://github.com/cisagov/icsnpp-opcua-binary && \
    zkg install --force --skiptests --version 833a78c04c2f623f6afcda6d3dc72cc288cb11d8 \
        https://github.com/cisagov/icsnpp-profinet-io-cm

# mergecap, for feeding many pcap files to Zeek as one capture.
#
# Deliberately a late layer rather than folded into the toolchain install
# above: that one sits below every zkg build, so extending it would discard
# the JA4/HASSH/ICSNPP compile cache on each change. This is also why it is
# not merged with the earlier apt step despite being the same kind of thing.
RUN apt-get update && \
    apt-get install -y --no-install-recommends wireshark-common && \
    rm -rf /var/lib/apt/lists/*

# Load every installed package, plus wire-level file extraction metadata.
# Note: this loads the *hashing* side of the file framework, not
# extract-all-files -- pulling real attacker binaries onto a workstation is a
# deliberate act (#1738), not a side effect of running the lab.
COPY local.zeek /usr/local/share/zeek-lab/local.zeek

RUN zeek -N | sort > /usr/local/share/zeek-lab/loaded-plugins.txt && \
    cat /usr/local/share/zeek-lab/loaded-plugins.txt

WORKDIR /work
ENTRYPOINT ["/bin/bash"]

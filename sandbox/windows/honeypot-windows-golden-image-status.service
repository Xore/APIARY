[Unit]
Description=Report win11-analysis.qcow2 golden image age/checksum staleness (#86)
Documentation=file:/usr/local/libexec/honeypot-sandbox/windows/IMPLEMENTATION_PLAN.md

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/honeypot-windows-sandbox
ExecStart=/usr/local/libexec/honeypot-sandbox/windows/golden-image-status.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/honeypot-windows-sandbox
ReadOnlyPaths=/var/dockge/sandbox

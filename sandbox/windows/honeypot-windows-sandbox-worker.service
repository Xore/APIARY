[Unit]
Description=Detonate queued honeypot payloads in the isolated Windows 11 guest
Documentation=file:/usr/local/libexec/honeypot-sandbox/windows/IMPLEMENTATION_PLAN.md
After=libvirtd.service virtnetworkd.socket docker.service
Requires=libvirtd.service

[Service]
Type=oneshot
# Host-specific values (VM_HOST, VM_PASS, LIBVIRT_URI, OBSERVATION_SECS, the
# spool paths) live outside the repository. The leading - keeps the unit
# usable before an operator has written the file.
EnvironmentFile=-/etc/default/honeypot-windows-sandbox
# /usr/local/libexec, not /opt: matches the Linux sandbox's own install
# convention (sandbox/install-worker.sh) exactly -- small helper scripts
# invoked by systemd, not user-facing binaries, so the FHS-standard libexec
# location on the root disk is correct here; it's the multi-GB golden
# images/ISOs that belong on the large /var spindle instead, not scripts.
ExecStart=/usr/local/libexec/honeypot-sandbox/windows/run_pending.sh
UMask=0077
# Detonation is background work on a host that is also serving sensors.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# One sample is a revert, a boot wait, an observation window and artifact
# collection. Comfortably above OBSERVATION_SECS for a queue of several.
# #297: OBSERVATION_SECS' default moved from 300s to 1800s (30 min), so
# 45min no longer covers more than one sample -- bumped to keep the "queue
# of several" headroom this comment already promised. Re-check this
# multiplier if OBSERVATION_SECS is tuned further per the default file's
# own note.
TimeoutStartSec=6h

# No [Install] section, deliberately -- matches the Linux sandbox's own
# honeypot-sandbox-worker.service (systemctl cat confirms it has none
# either). This unit is only ever started by the .path unit's Unit=
# trigger or an explicit `systemctl start`, never enabled for boot itself.

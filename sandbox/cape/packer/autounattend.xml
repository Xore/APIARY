<?xml version="1.0" encoding="utf-8"?>
<!-- autounattend.xml — Windows 11 unattended install for Packer/QEMU -->
<!-- Delivered on the secondary CD built by Packer cd_files, not a floppy:
     the q35 machine type has no floppy controller. Windows setup searches
     removable media for autounattend.xml, so no drive letter is assumed. -->
<!-- Ref: https://github.com/proactivelabs/packer-windows -->
<!-- Adapted from sandbox/windows/packer/autounattend.xml (#315): the
     Windows-install phase itself (language, partitioning, WinRM bring-up,
     the local "analyst" account) has nothing sandbox/windows-specific in
     it, so that part stays unchanged. #904: the decoy identity
     (ComputerName, FullName, Organization, RegisteredOwner,
     RegisteredOrganization, JoinWorkgroup below) used to be copied
     verbatim from win11-analysis's own guest, which meant a sample that
     had fingerprinted this repo's OTHER golden image once would recognize
     this one as the same decoy identity. It is now a distinct persona —
     Daniel Kowalski at Vantage Precision Manufacturing, vs. win11-analysis's
     Robert Tanaka at Ashford Capital Partners — so the two golden images no
     longer share a recognizable identity tell. This is identity/fingerprint
     distinctness only: unlike win11-analysis, win11-cape has no
     05-decoy-content.ps1 equivalent (no decoy documents, no fake
     recent-file shortcuts, no FakeNet intranet page) and no persona
     daemon — those stay deliberately excluded per win11-cape.pkr.hcl's
     own header (CAPE's debugger-class-evasion focus doesn't need full
     persona realism). The name/company below exists only in this file. -->

<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <!-- ===== Windows PE (pre-install) ===== -->
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <SetupUILanguage><UILanguage>en-US</UILanguage></SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

      <!-- Skip TPM/SecureBoot requirements for KVM -->
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add HKLM\SYSTEM\Setup\LabConfig /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>

      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order><Type>EFI</Type><Size>260</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order><Type>MSR</Type><Size>16</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order><Type>Primary</Type><Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order><PartitionID>1</PartitionID>
              <Label>System</Label><Format>FAT32</Format>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order><PartitionID>2</PartitionID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>3</Order><PartitionID>3</PartitionID>
              <Label>Windows</Label><Format>NTFS</Format><Letter>C</Letter>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
        <WillShowUI>OnError</WillShowUI>
      </DiskConfiguration>

      <ImageInstall>
        <OSImage>
          <!-- The retail/ESD media carries seven editions and no ei.cfg, so
               setup shows an edition picker unless one is named here. In an
               unattended headless build nothing answers it and Packer waits
               out winrm_timeout with no diagnostic. Pro is the analysis
               baseline: the N editions omit the Media Feature Pack that some
               samples and tooling expect, and Home has no Group Policy for
               the hardening pass. Run wiminfo against sources/install.esd if
               the media is ever replaced — this string must match a Name
               exactly. -->
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 11 Pro</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo><DiskID>0</DiskID><PartitionID>3</PartitionID></InstallTo>
          <WillShowUI>OnError</WillShowUI>
        </OSImage>
      </ImageInstall>

      <UserData>
        <!-- Empty ProductKey suppresses the "enter a product key" prompt,
             which is the other place an unattended install stops. The guest
             stays unactivated on purpose: it never reaches the internet, and
             it is reverted to the golden snapshot after every detonation, so
             activation would buy nothing. Unactivated Windows runs
             indefinitely with only cosmetic personalisation limits. -->
        <ProductKey>
          <Key></Key>
          <WillShowUI>Never</WillShowUI>
        </ProductKey>
        <AcceptEula>true</AcceptEula>
        <!-- #904: distinct from win11-analysis's own Robert Tanaka /
             Ashford Capital Partners persona, so the two golden images
             don't share a recognizable identity fingerprint. Unlike that
             image, nothing else in this build reads this name/company
             (no decoy documents, no FakeNet intranet page) — it only
             needs to agree with itself across this file's own fields
             below (ComputerName, RegisteredOwner, RegisteredOrganization,
             JoinWorkgroup). Change them together if this is ever
             re-themed. -->
        <FullName>Daniel Kowalski</FullName>
        <Organization>Vantage Precision Manufacturing</Organization>
      </UserData>

    </component>
  </settings>

  <!-- ===== Specialize ===== -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <!-- #904: distinct from win11-analysis's ACP-FIN0142 — reads as
           this persona's own corporate asset tag (Vantage Precision
           Manufacturing, Engineering-department asset 0089). A substring
           check for ANALY/SANDBOX/MALWARE/CAPE in the hostname is among
           the cheapest evasion checks a sample can run; this name avoids
           all four, same as win11-analysis's own. -->
      <ComputerName>VPM-ENG0089</ComputerName>
      <TimeZone>Eastern Standard Time</TimeZone>
      <RegisteredOwner>Daniel Kowalski</RegisteredOwner>
      <RegisteredOrganization>Vantage Precision Manufacturing</RegisteredOrganization>
    </component>

    <!-- #91: 01-hardening.ps1's Set-MpPreference/DisableAntiSpyware
         approach runs as a Packer WinRM provisioner, well after first
         boot and OOBE — confirmed live (2026-08-02) that by then Defender
         is fully armed (AMServiceEnabled/AntivirusEnabled/
         RealTimeProtectionEnabled all True, IsTamperProtected True,
         TamperProtection reg value 1) and those calls are silently
         reverted. specialize runs as SYSTEM before first user logon,
         before Defender's own service (let alone Tamper Protection, which
         needs Defender fully initialized plus cloud/MAPS connectivity
         first) has ever started — setting Start=4 here means WinDefend
         never starts in the first place, rather than trying to stop
         something already running and self-protecting. This is the
         documented, supported mechanism for this (unlike the windowsPE
         pass's LabConfig trick above, which only works for that specific,
         Microsoft-special-cased path) — specialize writes to the real
         installed-OS hive.

         RunSynchronous/RunSynchronousCommand belongs under
         Microsoft-Windows-Deployment, not Microsoft-Windows-Shell-Setup —
         confirmed live (2026-08-03) the hard way: this block had ended up
         nested inside Shell-Setup above, and Windows Setup rejected the
         whole answer file for it every single time, crashing with "The
         computer restarted unexpectedly or encountered an unexpected
         error" partway through the file-copy phase (well after 1GB
         written, so it looked nothing like an early rejection). Setup's
         own C:\Windows\Panther\setuperr.log (pulled by mounting the
         crashed build's qcow2 offline with qemu-nbd, since WinRM never
         comes up this early) had the real reason the GUI dialog never
         shows: "hrResult = 0x80220001 ... SMI data results dump: Source =
         Name: Microsoft-Windows-Shell-Setup ... /settings/RunSynchronous
         ... Description = Setting is not defined in this component." This
         is that reasoning turned back into the correct component split
         after finding it had regressed (see git history: commit 220ab17
         originally had this right, as its own separate
         Microsoft-Windows-Deployment component). -->
    <component name="Microsoft-Windows-Deployment"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\WinDefend" /v Start /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\WdBoot" /v Start /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\WdFilter" /v Start /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\WdNisDrv" /v Start /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>5</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\WdNisSvc" /v Start /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>6</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\Sense" /v Start /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>7</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\SecurityHealthService" /v Start /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>8</Order>
          <Path>reg add "HKLM\SYSTEM\CurrentControlSet\Services\wscsvc" /v Start /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>9</Order>
          <Path>reg add "HKLM\SOFTWARE\Microsoft\Windows Defender\Features" /v TamperProtection /t REG_DWORD /d 4 /f</Path>
        </RunSynchronousCommand>
        <!-- No BitLocker command here on purpose: see the oobeSystem
             FirstLogonCommands block below (Order 1) for why. A
             specialize-pass RunSynchronousCommand writing this same key was
             the only setup-time change between a build that installed
             cleanly and one that died with 0x8007000D (ERROR_INVALID_DATA)
             before writing a single gigabyte, Setup rejecting the answer
             file outright. That command was removed for exactly that
             reason and must not be re-added here. -->
      </RunSynchronous>
    </component>

    <!-- Workgroup named like a corporate domain, matching the persona —
         a bare WORKGROUP default is itself a tell. #904: distinct from
         win11-analysis's ACPNET (Ashford Capital Partners), matching this
         guest's own Vantage Precision Manufacturing persona instead. -->
    <component name="Microsoft-Windows-UnattendedJoin"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS">
      <Identification>
        <JoinWorkgroup>VPMNET</JoinWorkgroup>
      </Identification>
    </component>

    <component name="Microsoft-Windows-Security-SPP-UX"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS">
      <SkipAutoActivation>true</SkipAutoActivation>
    </component>

  </settings>

  <!-- ===== OOBE System ===== -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup"
               processorArchitecture="amd64"
               publicKeyToken="31bf3856ad364e35"
               language="neutral" versionScope="nonSxS"
               xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideLocalAccountScreen>true</HideLocalAccountScreen>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>

      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Password><Value>malware123!</Value><PlainText>true</PlainText></Password>
            <Description>Analysis account</Description>
            <DisplayName>analyst</DisplayName>
            <Group>Administrators</Group>
            <Name>analyst</Name>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>

      <AutoLogon>
        <Password><Value>malware123!</Value><PlainText>true</PlainText></Password>
        <Enabled>true</Enabled>
        <Username>analyst</Username>
      </AutoLogon>

      <!-- Bring WinRM up. This is the step Packer waits six hours for, so it
           is written defensively.

           `winrm quickconfig -q` alone is the trap: it refuses to create the
           firewall exception whenever a connection profile is Public, which is
           exactly what a fresh guest on QEMU user-mode networking gets. It
           exits non-zero, nothing listens on 5985, and the build dies with
           only "Timeout waiting for WinRM" six hours later.
           Enable-PSRemoting -SkipNetworkProfileCheck is the documented way
           past it. The service is then forced to Automatic and started so a
           reboot during provisioning cannot leave it down.

           C:\winrm-ready.txt is the post-mortem marker: if a build times out
           on WinRM again, mount the qcow2 and check for it to tell "OOBE never
           reached first logon" apart from "first logon ran but WinRM did not
           come up". -->
      <FirstLogonCommands>
        <!-- Defender exclusions come first, deliberately: the instant WinRM
             answers, Packer starts uploading 01-hardening.ps1, and if
             Defender is still inspecting content that upload is rejected
             mid-stream.

             Disabling Defender outright is not possible here. Tamper
             Protection is on by default in Windows 11 and guards its own
             registry key against SYSTEM as well as Administrators — measured
             on a booted build: every policy key written during specialize was
             absent or reverted, and a direct write returned "Requested
             registry access is not allowed". specialize is simply not early
             enough; Defender is already protecting itself by then.

             Exclusions are what Tamper Protection does permit, and they are
             enough. Measured on the same guest: uploading the provisioning
             script failed at offset 1800 with "This script contains malicious
             content"; after adding these exclusions the identical content
             uploaded and parsed. Note that Add-MpPreference succeeds while
             Get-MpComputerStatus still reports RealTimeProtectionEnabled=True
             — the exclusions apply even though the engine stays on, which is
             the outcome we want: no protection theatre, no blocked tooling.

             The .ps1 extension and powershell.exe process exclusions matter as
             much as the paths, because AMSI scans script *content* rather than
             the file's location. -->
        <!-- BitLocker prevention lives here rather than in a specialize-pass
             RunSynchronous component. Adding that component was the only
             setup-time change between the build that installed cleanly and
             the one that died with 0x8007000D (ERROR_INVALID_DATA) before
             writing a single gigabyte — Windows Setup rejected the answer
             file. Device encryption does not begin until after OOBE, so first
             logon is early enough, and this keeps the setup-time answer file
             identical to the shape that is known to install. -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>reg add "HKLM\SYSTEM\CurrentControlSet\Control\BitLocker" /v PreventDeviceEncryption /t REG_DWORD /d 1 /f</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "foreach ($p in @('C:\Windows\Temp','C:\Tools','C:\ProgramData\chocolatey','C:\Users\analyst','C:\Samples','C:\Logs')) { try { Add-MpPreference -ExclusionPath $p -ErrorAction SilentlyContinue } catch {} }; try { Add-MpPreference -ExclusionExtension 'ps1','exe','dll' -ErrorAction SilentlyContinue } catch {}; try { Add-MpPreference -ExclusionProcess 'powershell.exe' -ErrorAction SilentlyContinue } catch {}; try { Set-MpPreference -MAPSReporting Disabled -SubmitSamplesConsent NeverSend -ErrorAction SilentlyContinue } catch {}; ((Get-MpPreference).ExclusionPath -join ', ') | Set-Content C:\defender-exclusions.txt"</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine>powershell -NoProfile -ExecutionPolicy Bypass -Command "Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private -ErrorAction SilentlyContinue; Enable-PSRemoting -Force -SkipNetworkProfileCheck"</CommandLine>
          <RequiresUserInput>false</RequiresUserInput>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>4</Order>
          <CommandLine>cmd /c winrm set winrm/config/service @{AllowUnencrypted="true"}</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>5</Order>
          <CommandLine>cmd /c winrm set winrm/config/service/auth @{Basic="true"}</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>6</Order>
          <CommandLine>cmd /c netsh advfirewall firewall add rule name="WinRM" dir=in action=allow protocol=tcp localport=5985</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>7</Order>
          <CommandLine>cmd /c net localgroup "Remote Management Users" analyst /add</CommandLine>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>8</Order>
          <CommandLine>powershell -NoProfile -Command "Set-Service WinRM -StartupType Automatic; Start-Service WinRM; Set-Content -Path C:\winrm-ready.txt -Value (Get-Date -Format o)"</CommandLine>
        </SynchronousCommand>
        <!-- The specialize-pass policy keys are what actually stop AMSI, but
             repeat the intent through the supported API now the service is
             running, and record the outcome. If a future build is blocked by
             Defender again, C:\defender-off.txt says whether this ran and what
             the engine reported afterwards. -->
        <SynchronousCommand wcm:action="add">
          <Order>9</Order>
          <CommandLine>powershell -NoProfile -Command "try { Set-MpPreference -DisableRealtimeMonitoring $true -DisableScriptScanning $true -DisableBehaviorMonitoring $true -ErrorAction Stop } catch {}; try { (Get-MpComputerStatus | Select-Object RealTimeProtectionEnabled,AntivirusEnabled,IsTamperProtected | Out-String) | Set-Content C:\defender-off.txt } catch { 'Get-MpComputerStatus unavailable' | Set-Content C:\defender-off.txt }"</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>

    </component>
  </settings>

</unattend>

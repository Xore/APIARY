# Raw guest output and qcow2-independent reports stay root-only for this many days.
SANDBOX_RAW_RETENTION_DAYS=30
# Sanitized JSON summaries remain visible in the dashboard for this many days.
SANDBOX_EXPORT_RETENTION_DAYS=180
# Optional alternate immutable Linux base image.
SANDBOX_LINUX_BASE=/var/lib/honeypot-sandbox/base/ubuntu-noble.qcow2
# Windows PE files always receive static forensic analysis. Use "wine" only to
# execute EXEs under headless Wine inside the disposable, isolated KVM guest.
SANDBOX_WINDOWS_MODE=wine
# "controlled" enables real DNS plus an allowlisted HTTP/HTTPS retrieval proxy.
# It never enables direct guest routing or unrestricted Internet access.
SANDBOX_NETWORK_MODE=isolated
# Serial workers mean only one guest consumes this memory at a time.
SANDBOX_VM_MEMORY_MB=3072

[Unit]
Description=Allowlisted HTTP and HTTPS proxy for honeypot forensic retrieval
Requires=honeypot-sandbox-egress-network.service honeypot-sandbox-egress-dns.service
After=honeypot-sandbox-egress-network.service honeypot-sandbox-egress-dns.service

[Service]
Type=simple
ExecStart=/usr/sbin/squid -N -f /etc/honeypot-sandbox/squid.conf
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/log/honeypot-sandbox/proxy /var/spool/squid /run

[Install]
WantedBy=multi-user.target

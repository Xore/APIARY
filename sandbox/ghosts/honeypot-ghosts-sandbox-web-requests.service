[Unit]
Description=Validate dashboard GHOSTS sandbox-analysis requests
After=docker.service libvirtd.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/honeypot-ghosts-sandbox
ExecStart=/usr/local/libexec/honeypot-sandbox/ghosts/process-ghosts-web-requests.sh
UMask=0077
Nice=10
TimeoutStartSec=2min

# No [Install] section, deliberately -- matches
# honeypot-windows-sandbox-web-requests.service. Only ever started by
# honeypot-ghosts-sandbox-worker.path's Unit= trigger.

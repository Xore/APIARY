            "UtcTimeOn": "13:00:00",
            "UtcTimeOff": "22:00:00",
            "Loop": true,
            "HandlerArgs": {
                "execution-probability": "60",
                "creation-probability": "35",
                "modification-probability": "30",
                "deletion-probability": "10",
                "view-probability": "25",
                "output-directory": "%USERPROFILE%\\Documents",
                "input-directory": "%USERPROFILE%\\Documents",

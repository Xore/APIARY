{
    "Status": "Run",
    "TimeLineHandlers": [
        {
            "HandlerType": "BrowserChrome",
            "Initial": "https://www.bloomberg.com/",
            "UtcTimeOn": "12:00:00",
            "UtcTimeOff": "23:00:00",
            "Loop": true,
            "HandlerArgs": {
                "stickiness": "60",
                "stickiness-depth-min": "1",
                "stickiness-depth-max": "3",
                "delay-jitter": "30",
                "isheadless": "false",
                "command-line-args": [
                    "--disable-blink-features=AutomationControlled",

                        "https://www.linkedin.com/feed/",
                        "https://www.federalreserve.gov/monetarypolicy/fomccalendars.htm"
                    ],
                    "DelayAfter": 240000,
                    "DelayBefore": 10000
                }
            ]
        },
        {
            "HandlerType": "Clicks",
            "UtcTimeOn": "12:00:00",
            "UtcTimeOff": "23:00:00",
            "Loop": true,
            "TimeLineEvents": [
                {
                    "Command": "click",
                    "CommandArgs": [45000, -25000, 25000],

{
    "Status": "Run",
    "TimeLineHandlers": [
        {
            "HandlerType": "Bash",
            "Initial": "",
            "UtcTimeOn": "00:00:00",
            "UtcTimeOff": "24:00:00",
            "Loop": true,
            "HandlerArgs": {
                "execution-probability": "100",
                "delay-jitter": "10"
            },
            "TimeLineEvents": [
                {
                    "Command": "random",
                    "CommandArgs": [
                        "whoami",
                        "hostname",
                        "uname -a",
                        "uptime",
                        "df -h",
                        "ls /tmp",
                        "date",
                        "cat /etc/os-release",
                        "ps aux --sort=-%mem | head -5",
                        "ip addr show | grep inet"
                    ],
                    "DelayAfter": 30000,
                    "DelayBefore": 5000
                }
            ]
        }
    ]
}

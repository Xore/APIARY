# pihole — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# REQUIRED: the homeserver's LAN IP address (was a text-substituted
# __LAN_IP__ placeholder before #1502; see this compose.yml's own header).
LAN_IP=

# REQUIRED: Pi-hole web admin password.
PIHOLE_PASSWORD=

# optional, defaults to 'Europe/Berlin' if unset
INSTALL_TIMEZONE=Europe/Berlin

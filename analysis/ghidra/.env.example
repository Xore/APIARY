# Copy to .env in this directory (analysis/ghidra/, or the deployed stack
# folder under /opt/stacks/ghidra/ on a Dockge host -- see
# install-analysis-host.sh). docker-compose.ghidra.yml reads it for variable
# substitution.

# Interface revdeck publishes on. Leave unset (defaults to 127.0.0.1) to keep
# it loopback-only, exactly like ghidra/ollama/statictools above it in this
# file. Set to the same WireGuard address APIARY's HP_BIND uses to
# reach it via Traefik + forward-auth SSO instead -- see vps/docker-compose.yml
# (socat-hp-revdeck) and vps/traefik/dynamic.yml for the other half of that
# path. Everything else in this compose file (ghidra, ollama, statictools)
# stays loopback-only regardless of this value; only revdeck's binding reads it.
HP_BIND=127.0.0.1

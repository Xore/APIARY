[Unit]
Description=Watch for honeypot Ghidra analysis requests
Documentation=file:/opt/honeypot-ghidra/DASHBOARD_INTEGRATION_PLAN.md
After=docker.service

[Path]
# The dashboard writes {sha256}.request here; it never calls the Ghidra REST
# service itself. Same trust boundary as the sandbox spools.
PathChanged=/ghidra-requests
Unit=honeypot-ghidra-worker.service

[Install]
WantedBy=multi-user.target

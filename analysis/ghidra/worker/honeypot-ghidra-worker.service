[Unit]
Description=Run Ghidra headless analysis on queued honeypot payloads
Documentation=file:/opt/honeypot-ghidra/DASHBOARD_INTEGRATION_PLAN.md
After=docker.service
# Wants, not Requires: if the REST container is down the worker exits without
# consuming the queue, which is a better outcome than refusing to start and
# leaving the operator to work out why nothing drained.
Wants=docker.service

[Service]
Type=oneshot
# Host-specific values (the spool paths, GHIDRA_API_BASE, the samples
# directory) live outside the repository. The leading - keeps the unit usable
# before an operator has written the file.
EnvironmentFile=-/etc/default/honeypot-ghidra
# Optional host dependency: graphviz. Without `dot` the worker still writes
# {sha}_callgraph.dot and the analysis completes; only the rendered picture is
# missing, and the page says so rather than showing a broken image.
#   apt-get install graphviz
ExecStart=/usr/bin/python3 /opt/honeypot-ghidra/worker/ghidra-worker.py
UMask=0077
# Decompiling a large binary is CPU-hungry background work on a host that is
# also serving sensors and, at times, building a golden image.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Ghidra's own budget is ANALYSIS_TIMEOUT=3600 per binary
# (docker-compose.ghidra.yml). This covers a queue of several plus polling
# overhead; the worker's GHIDRA_ANALYSIS_TIMEOUT bounds each one.
TimeoutStartSec=4h

# The worker needs the spools and the loopback REST port, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# HOST paths, not the container ones. /ghidra-requests and /ghidra-results are
# where docker-compose.yml mounts these directories *inside the dashboard
# container*; this unit runs on the host, where they do not exist. Listing the
# container paths here combined with ProtectSystem=strict leaves the worker
# unable to write anywhere, and the first symptom is a read-only filesystem
# error on a spool the operator can see is perfectly writable.
#
# These must agree with GHIDRA_REQUEST_DIR/GHIDRA_RESULTS_DIR and
# REVDECK_REQUEST_DIR/REVDECK_RESULTS_DIR in /etc/default/honeypot-ghidra.
# systemd cannot expand EnvironmentFile values here, so pointing the worker
# at a different directory means editing both.
ReadWritePaths=/var/lib/honeypot-ghidra/requests/pending /var/lib/honeypot-ghidra/results /run/lock /var/lib/honeypot-revdeck/requests/pending /var/lib/honeypot-revdeck/results

[Install]
WantedBy=multi-user.target

# Vault-ingest worker (#1634 stage 2 / #2290). Two-flag opt-in beyond
# VAULT_DRY_RUN, mirroring llm-worker's LLM_ENABLED + LLM_ALLOW_CAPTURED_DATA
# gate -- see #2289's decision record (docs/knowledge-store-design.md).
VAULT_ENABLED=false
VAULT_DRY_RUN=true
VAULT_ALLOW_CAPTURED_DATA=false

VAULT_POLL_INTERVAL_SECONDS=900
VAULT_MAX_DOCS_PER_CYCLE=500
VAULT_MAX_TEXT_CHARS=4000
VAULT_MAX_LIST_ITEMS=30

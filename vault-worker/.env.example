# Vault-ingest worker (#1634 stage 2 / #2290). Two-flag opt-in beyond
# VAULT_DRY_RUN, mirroring llm-worker's LLM_ENABLED + LLM_ALLOW_CAPTURED_DATA
# gate -- see #2289's decision record (docs/knowledge-store-design.md).
VAULT_ENABLED=false
VAULT_DRY_RUN=true
VAULT_ALLOW_CAPTURED_DATA=false

VAULT_POLL_INTERVAL_SECONDS=900
VAULT_MAX_DOCS_PER_CYCLE=500
VAULT_MAX_TEXT_CHARS=4000
VAULT_MAX_LIST_ITEMS=30

# #2291: embeddings only, no completion model. Off by default; enabling
# requires pinning the exact digest of the installed model (same posture
# llm-worker's LLM_EMBEDDING_ENABLED/LLM_EMBEDDING_EXPECTED_DIGEST pair
# enforces) so a silently-swapped model can never go unnoticed.
VAULT_EMBEDDING_ENABLED=false
VAULT_EMBEDDING_MODEL=nomic-embed-text:latest
VAULT_EMBEDDING_EXPECTED_DIGEST=

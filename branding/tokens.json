{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "brand": {
    "name": "APIARY",
    "tagline": "Automated Payload Intelligence & Attacker Response"
  },
  "color": {
    "dark": {
      "background": {"$value": "#20201f", "$type": "color"},
      "sidebar": {"$value": "#1e1e1c", "$type": "color"},
      "surface": {"$value": "#2c2c2a", "$type": "color"},
      "surfaceRaised": {"$value": "#383835", "$type": "color"},
      "text": {"$value": "#e9e6df", "$type": "color"},
      "textSecondary": {"$value": "#a8a49c", "$type": "color"},
      "textMuted": {"$value": "#8c8f8d", "$type": "color"},
      "accent": {"$value": "#d97757", "$type": "color"}
    },
    "light": {
      "background": {"$value": "#f7f6f2", "$type": "color"},
      "sidebar": {"$value": "#f0efeb", "$type": "color"},
      "surface": {"$value": "#fbfaf7", "$type": "color"},
      "surfaceRaised": {"$value": "#ebe9e3", "$type": "color"},
      "text": {"$value": "#2f2b27", "$type": "color"},
      "textSecondary": {"$value": "#68615a", "$type": "color"},
      "textMuted": {"$value": "#918a82", "$type": "color"},
      "accent": {"$value": "#b9583c", "$type": "color"}
    },
    "semantic": {
      "link": {"$value": "#6da7ec", "$type": "color"},
      "success": {"$value": "#79c99e", "$type": "color"},
      "warning": {"$value": "#deb36a", "$type": "color"},
      "danger": {"$value": "#dc7774", "$type": "color"}
    }

networks:
  # Shared with the main honeypot-dashboard stack (and the wider APIARY
  # stack) -- explicit fixed name, not project-prefixed, non-external. Same
  # mechanism honeypot-dashboard/compose.yml's own header documents and
  # every other split-out worker stack in arcane/home/ already relies on.
  honeynet:
    name: honeynet
    driver: bridge
  # #2329: shared with analysis/ghidra/docker-compose.ghidra.yml, which owns

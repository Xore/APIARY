# Copy to .env in this vps/ directory and fill in the values.
# docker-compose will automatically load .env from the same directory.

# ── Auth Portal ──────────────────────────────────────────────────────
AUTH_HOST=auth.honeypot.example
COOKIE_DOMAIN=.honeypot.example
COOKIE_NAME=honeypot_sso

# openssl rand -hex 32 - keep stable across restarts/replicas
COOKIE_SECRET=CHANGE_ME_openssl_rand_hex_32
# During a cookie-key rotation, put the former key here (comma-separated if
# necessary). Remove it after every old session has expired.
COOKIE_SECRET_PREVIOUS=

AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME_use_a_password_manager

# Optional bootstrap secret for the initial admin. A logged-in user can enroll
# or replace TOTP at https://auth.honeypot.example/_auth/enroll.
TOTP_SECRET=
TOTP_ISSUER=auth.honeypot.example
REQUIRE_TOTP=true
TRUST_DEVICE_DAYS=0
# Optional comma-separated proxy CIDRs trusted to set client-IP headers.
TRUSTED_PROXIES=

SESSION_TTL_HOURS=12
MAX_ATTEMPTS=5
LOCKOUT_MINUTES=15
MIN_DWELL_SECONDS=2
FORM_TTL_MINUTES=15
COOKIE_SECURE=true
MAX_BODY_KB=64

# Optional alert webhook and bearer token for /_auth/metrics.
WEBHOOK_URL=
METRICS_TOKEN=

# ── Suricata IDS ─────────────────────────────────────────────────────
# Public NIC Suricata sniffs. STRATO VPS default is ens6.
SURICATA_IFACE=ens6

# HOME_NET must be the VPS public IP in CIDR notation — never "any".
# Rules using !$HOME_NET with HOME_NET=any produce a NIL address range
# and cause a fatal parse error at startup.
#
# Get your VPS public IP: curl -s ifconfig.me
# Then set it here as a /32:
SURICATA_HOME_NET=YOUR.VPS.IP.HERE/32

# EXTERNAL_NET should be the inverse of HOME_NET.
# If you have multiple IPs or also want to include the WireGuard range:
#   SURICATA_HOME_NET=[203.0.113.10/32,10.8.0.0/24]
SURICATA_EXTERNAL_NET=!$SURICATA_HOME_NET

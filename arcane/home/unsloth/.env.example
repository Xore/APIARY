# unsloth — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# Host address JupyterLab is published on (port 8899). The round-7 notebook
# is reached over the LAN, so set this to the homeserver's LAN address here;
# the real value is deployment-specific and stays out of git.
# Optional, defaults to '10.8.0.2' (WireGuard only) if unset.
UNSLOTH_BIND=<homeserver-lan-ip>

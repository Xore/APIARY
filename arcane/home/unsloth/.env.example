# unsloth — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# Host address Unsloth Studio is published on (port 8899). Studio is reached
# over the LAN, so set this to the homeserver's LAN address here; the real
# value is deployment-specific and stays out of git.
# Optional, defaults to '10.8.0.2' (WireGuard only) if unset.
UNSLOTH_BIND=<homeserver-lan-ip>

# JupyterLab login password (port 8888), read by the image's launcher.
# Required: compose refuses to start without it (#3337). Studio's own admin
# password (port 8899) is separate -- Studio prints a bootstrap password to
# the container log on first boot and shuts itself down if it is not changed
# within 60 minutes. The real password lives only in the untracked .env.
JUPYTER_PASSWORD=<jupyter-password>

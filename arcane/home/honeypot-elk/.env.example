# honeypot-elk — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to 'change-me-in-env' if unset
ARKIME_PASSWORD_SECRET=change-me-in-env

# optional, defaults to '10.8.0.2' if unset
HP_BIND=10.8.0.2

# optional, defaults to 'CHANGE_ME_32_CHAR_MINIMUM_KEY_1234' if unset
KIBANA_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MINIMUM_KEY_1234

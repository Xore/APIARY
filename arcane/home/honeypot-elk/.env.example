# honeypot-elk — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to 'change-me-in-env' if unset
ARKIME_PASSWORD_SECRET=change-me-in-env

# optional, defaults to '60' if unset (seconds between extracted-file
# imports into Elasticsearch)
EXTRACT_IMPORT_INTERVAL=60

# optional, defaults to '10.8.0.2' if unset
HP_BIND=10.8.0.2

# optional, defaults to 'CHANGE_ME_32_CHAR_MINIMUM_KEY_1234' if unset
KIBANA_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_MINIMUM_KEY_1234

# optional, defaults to '200' if unset (GB ceiling for the pcap staging
# store; keep it comfortably below free space -- Arkime's own freeSpaceG
# only protects Arkime's copy, not this staging store)
PCAP_MAX_GB=200

# optional, defaults to '14' if unset (days to keep log.pcap.* files)
PCAP_RETENTION_DAYS=14

# REQUIRED: zeek-proxy refuses to start while this is unset ("refusing to
# start rather than sniff nothing"). It must name the host-side bridge
# interface to sniff -- a bridge is a switch, so traffic between two other
# containers never reaches a third interface on its own.
ZEEK_PROXY_IFACE=

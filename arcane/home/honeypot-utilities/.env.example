# honeypot-utilities — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to '' if unset; requires BLOCKLISTDE_SENDER plus
# BLOCKLISTDE_API_KEY below for the second provider (#2330)
ABUSEIPDB_API_KEY=

# optional, defaults to '' if unset; both required together, and
# REPORTER_LIVE must be set before either provider sends anything
BLOCKLISTDE_SENDER=
BLOCKLISTDE_API_KEY=

# optional, defaults to '' if unset
GREYNOISE_API_KEY=

# optional, defaults to '24' if unset
GREYNOISE_CACHE_HOURS=24

# optional, defaults to '0' if unset
GREYNOISE_ENABLED=0

# optional, defaults to 'open' if unset
GREYNOISE_FAIL_MODE=open

# optional, defaults to '30' if unset (compose.yml's own fallback is
# unchanged); shipped here as 21 -- #2820: see the root .env.example's
# #2820 note
HONEYPOT_RETENTION_DAYS=21

# optional, minutes; derived from HONEYPOT_RETENTION_DAYS x 1440 / 10
# (3024 against the 21d default) if unset
JSON_RETENTION_MINUTES=

# optional, days; derived from HONEYPOT_RETENTION_DAYS / 10 (2 against
# the 21d default) if unset
MAILONEY_MAIL_RETENTION_DAYS=

# optional, defaults to '24' if unset
REPORTER_COOLDOWN_HOURS=24

# optional, defaults to '' if unset
REPORTER_LIVE=

# optional, defaults to '3' if unset
REPORTER_MIN_EVENTS=3

# #2882: audit.json (reporter-data volume) grew unbounded -- 5.99 GB with no
# rotation, on a 128M-limited container, and not in any retention ledger
# (it's a named-volume sink, not a /logs/ bind mount, so
# scripts/check-json-sink-retention-parity.py's usual enumeration couldn't
# see it -- added as its own VOLUME_SINKS entry there). Rotates in-process
# (audit.go's rotatingWriter) at this byte threshold, same default and shape
# as log-maintenance.sh's MAX_LOG_BYTES (268435456 = 256MB). 0 disables
# rotation entirely.
#
# GROWTH RATE: the file's first entry is timestamped 2026-08-09T20:14:53Z,
# so 5,994,791,737 bytes is 25 days of accumulation -- a lifetime average of
# ~240 MB/day. Measured over an 18.5 h window on 2026-09-03 the current rate
# is ~62 MB/day. #2882's body says ~2.9 GB/day; that figure divided the whole
# file by ~2 days and is wrong by roughly an order of magnitude. The real
# rate is what makes this cap the right size: at ~240 MB/day rotation fires
# a little under once a day, so 4 generations hold days-to-weeks of audit
# history. At 2.9 GB/day it would fire ~11x a day and hold about ten hours.
#
# This knob delivers no near-term /var relief. newRotatingWriter seeds its
# size from Stat(), so on first start against the existing ~6 GB file it
# rotates on the very first write -- which makes audit.json.1 a 6 GB file.
# With keep=4 and roughly one rotation a day, those 6 GB are not actually
# released for about four days after deployment.
REPORTER_AUDIT_MAX_BYTES=268435456

# optional, defaults to '4' if unset -- number of rotated audit.json.N
# generations kept before the oldest ages out. Same default as
# log-maintenance.sh's ROTATIONS.
REPORTER_AUDIT_ROTATIONS=4

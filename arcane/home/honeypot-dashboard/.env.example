# honeypot-dashboard — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to '10' if unset
AGENT_INTRUSION_FETCH_WINDOW_DAYS=10

# optional, defaults to '10000' if unset
AGENT_INTRUSION_MAX_EVENTS_PER_SOURCE=10000

# optional, defaults to '300' if unset
AGENT_INTRUSION_POLL_INTERVAL=300

# optional, defaults to '' if unset
ARKIME_PUBLIC_URL=

# optional, defaults to '15m' if unset
ATTACKER_IDENTITY_RUN_INTERVAL=15m

# optional, defaults to 'https://auth.example.invalid/realms/apiary/account/' if unset
AUTH_ACCOUNT_URL=https://auth.example.invalid/realms/apiary/account/

# optional, defaults to 'https://auth.example.invalid/admin/apiary/console/' if unset
AUTH_ADMIN_URL=https://auth.example.invalid/admin/apiary/console/

# optional, defaults to '' if unset — #1608 cross-host split: the frontend
# tier's route to the BFF tier when SERVE_MODE=frontend splits them onto
# different docker hosts. Unused (loopback, same process) while
# DASHBOARD_SERVE_MODE stays at its 'all' default.
BFF_INTERNAL_URL=

# optional, defaults to '' if unset
CANARYTOKENS_API_URL=

# optional, defaults to '' if unset
CAPE_REQUEST_DIR=

# optional, defaults to '' if unset
CAPE_RESULTS_DIR=

# optional, defaults to '168h' if unset
CORRELATION_WINDOW=168h

# optional, defaults to '15m' if unset
CORRELATOR_RUN_INTERVAL=15m

# optional, defaults to '' if unset — #1616 scaling: the shared undici
# keep-alive pool's max sockets to the Rust tier.
DASHBOARD_BACKEND_HTTP_MAX_SOCKETS=

# optional, defaults to '' if unset — #1616 scaling: max concurrent
# requests the BFF admits to the Rust tier before queuing.
DASHBOARD_BACKEND_MAX_INFLIGHT=

# optional, defaults to '' if unset — #1616 scaling: how many more
# requests queue behind DASHBOARD_BACKEND_MAX_INFLIGHT before the BFF
# sheds load with 503 instead of growing the queue further.
DASHBOARD_BACKEND_MAX_QUEUE=

# optional, defaults to OIDC_EXTERNAL_URL if unset — #1628 staged/beta
# path: dashboard-next's own OIDC redirect host, separate from
# OIDC_EXTERNAL_URL (which production's `dashboard` also reads) since
# Keycloak only accepts an exact-match registered redirect_uri per host.
# Leave unset until dashboard-next is ever meant to be reachable at a
# different host than production (e.g. beta.honeypot.<domain>) — setting
# it requires registering that host's /auth/callback on the Keycloak
# apiary-dashboard client first (see docs/KEYCLOAK-CUTOVER.md).
DASHBOARD_NEXT_OIDC_EXTERNAL_URL=

# optional, defaults to 'true' if unset
DASHBOARD_REQUIRE_ADMIN=true

# optional, defaults to '/var/dockge/stacks/honeypot-dashboard/secrets' if unset
DASHBOARD_SECRETS_DIR=/var/dockge/stacks/honeypot-dashboard/secrets

# optional, defaults to 'all' if unset — #1608 cross-host split: 'all'
# (frontend+BFF combined, the only mode actually deployed today),
# 'frontend', or 'bff'. See BFF_INTERNAL_URL above.
DASHBOARD_SERVE_MODE=all

# optional, defaults to '' (disabled) if unset — the shared secret
# dashboard-next and backend-service authenticate each other with
# (SERVICE_TOKEN in backend-service's own environment, same value). Empty
# disables the check entirely; both tiers share the honeynet bridge with
# every honeypot sensor container, so this should be set to a real value
# before any real deployment, not left at the default. Set the identical
# value here and in honeypot-dashboard-backend's own env.
DASHBOARD_SERVICE_TOKEN=

# optional, defaults to '' if unset — #1616 scaling: cluster.mjs's worker
# count, default min(4, host cpus) when unset.
DASHBOARD_WEB_CONCURRENCY=

# optional, defaults to '300' if unset
ES_IMPORTER_INTERVAL=300

# optional, defaults to '1' if unset
ES_IMPORTER_SHARD_COUNT=1

# optional, defaults to '' if unset
EVEBOX_PUBLIC_URL=

# optional, defaults to '6h' if unset
EVIDENCE_WINDOW=6h

# optional, defaults to 'http://filebeat:5066' if unset
FILEBEAT_URL=http://filebeat:5066

# optional, defaults to 'false' if unset
GHIDRA_ALERT_ON_CRYPTO=false

# optional, defaults to 'high,critical' if unset
GHIDRA_ALERT_RISK_LEVELS=high,critical

# optional, defaults to '' if unset
GHIDRA_REQUEST_DIR=

# optional, defaults to '' if unset
GHIDRA_RESULTS_DIR=

# optional, defaults to '' if unset
GHOSTS_SANDBOX_REQUEST_DIR=

# optional, defaults to '' if unset
GHOSTS_SANDBOX_RESULTS_DIR=

# optional, defaults to '10' if unset
GITHUB_ANALYSIS_ALERT_POSITIVES=10

# optional, defaults to '' if unset
GITHUB_ANALYSIS_REQUEST_DIR=

# optional, defaults to '' if unset
GITHUB_ANALYSIS_RESULTS_DIR=

# optional, defaults to '' if unset
HONEYFS_IMPLANT_TOKEN=

# optional, defaults to '' if unset
HONEYFS_IMPLANT_URL=

# optional, defaults to '80' if unset
HONEYPOT_ALERT_CAMPAIGN_SCORE=80

# optional, defaults to '6h' if unset
HONEYPOT_ALERT_COOLDOWN=6h

# optional, defaults to '10' if unset
HONEYPOT_ALERT_INGEST_FLOOR_PERCENT=10

# optional, defaults to '1000' if unset
HONEYPOT_ALERT_INGEST_MIN_BASELINE=1000

# optional, defaults to '' if unset
HONEYPOT_ALERT_WEBHOOK_URL=

# optional, defaults to '' if unset
HONEYPOT_DOMAIN=

# optional, defaults to '© OpenStreetMap contributors' if unset
HONEYPOT_MAP_ATTRIBUTION=© OpenStreetMap contributors

# optional, defaults to 'https://tile.openstreetmap.org/{z' if unset
HONEYPOT_MAP_TILE_URL=https://tile.openstreetmap.org/{z

# optional, defaults to '10.8.0.2' if unset
HP_BIND=10.8.0.2

# optional, defaults to '67108864' if unset
JSON_STREAM_MAX_BYTES=67108864

# optional, defaults to '' if unset
KIBANA_PUBLIC_URL=

# optional, defaults to 'high,critical' if unset
LLM_ANALYSIS_ALERT_SEVERITIES=high,critical

# optional, defaults to '90' if unset
LOG_STREAM_ALERT_PERCENT=90

# optional, defaults to 'https://honeypot.example.invalid' if unset
OIDC_EXTERNAL_URL=https://honeypot.example.invalid

# optional, defaults to 'https://auth.example.invalid/realms/apiary' if unset
OIDC_ISSUER_URL=https://auth.example.invalid/realms/apiary

# optional, defaults to '' if unset
REVDECK_REQUEST_DIR=

# optional, defaults to '' if unset
REVDECK_RESULTS_DIR=

# optional, defaults to '50' if unset
SANDBOX_ALERT_RISK_SCORE=50

# optional, defaults to '' if unset
SANDBOX_VNC_BRIDGE_WS=

# optional, defaults to '' if unset
WINDOWS_SANDBOX_REQUEST_DIR=

# optional, defaults to '' if unset
WINDOWS_SANDBOX_RESULTS_DIR=

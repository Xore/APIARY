# Copy to .env in the honeypot-init stack folder (Dockge → Edit shows it).
# Compose reads it. Separate from this repo's root .env.example, which is for
# the APIARY Dockge stack -- these are two different Compose projects
# (see docker-compose.init.yml's own header comment for why).

# arkime-init sets this as Arkime's session-auth secret. MUST match
# ARKIME_PASSWORD_SECRET in APIARY's .env exactly -- arkime-capture/
# arkime-viewer (that stack) use it too, and Dockge gives each stack its own
# .env, so this is a manual sync, not automatic.
ARKIME_PASSWORD_SECRET=CHANGE_ME_IN_ENV

# arkime_add_user.sh requires a positional password argument, but --webauthonly
# (see arkime-init in docker-compose.init.yml) discards it immediately in
# favor of a random, never-recorded passStore -- this value is never actually
# used to log in. Set it to anything.
ARKIME_ADMIN_PASSWORD=CHANGE_ME_ARKIME

# Only needed if you want the optional geoipupdate job (profiles: [geoip-update]).
# Leave both empty to leave it off.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# #827 / #1765: the fleet's own addresses, and the VPS's public address.
#
# ES_HOME_NET is a comma-separated list of bare IPs (exact match, not CIDR).
# It is what lets the ingest pipeline tell "the attacker sent this" from "we
# answered" -- without it, every SYN-ACK and HTTP response is attributed to
# whichever end the sensor called the source, which is us.
#
# PUBLIC_IP completes the wire tuple for Traefik requests. Traefik logs the
# client side of a connection but never the address it accepted on, so with
# this unset those documents get no community_id and join to nothing.
#
# Both fail quietly when unset. That is deliberate -- a wrong join key is
# worse than none -- but it means an empty value here is invisible until
# somebody asks why a sensor has no attacker IPs.
ES_HOME_NET=
PUBLIC_IP=

# #261: the fleet-wide retention knob, in days -- one variable every
# sensor/analysis stack composes its own retention defaults from, so
# keeping logs longer (or shorter) is a single change here rather than an
# edit per stack. Optional here because docker-compose.init.yml only passes
# it through; defaults to '30' where a stack needs a concrete value.
HONEYPOT_RETENTION_DAYS=30

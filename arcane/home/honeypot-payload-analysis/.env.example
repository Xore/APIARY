# honeypot-payload-analysis — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# #261: the fleet-wide retention knob, in days. This stack composes its own
# BISTREAMS_RETENTION_DAYS default from it (see below), so setting it here
# shifts every downstream default at once.
#
# #2820: lowered from 30 to 21, to stay consistent with the fleet knob.
# Note this stack's only consumer of it is BISTREAMS_RETENTION_DAYS, which
# is pinned explicitly below -- so the value on this line is inert here by
# design, not by oversight.
HONEYPOT_RETENTION_DAYS=21

# optional; when unset (or empty) falls back to ${HONEYPOT_RETENTION_DAYS:-30}
# -- compose nests that default directly (see dedupe-payloads service)
#
# #2862 (decided 2026-09-03): stays at 30, permanently, on the forensic
# argument, not the disk argument. This is the one retention window in the
# fleet that irreversibly deletes *captured samples* --
# dedupe-payloads.py's prune_old_directories() removes whole date-named
# subtrees of dionaea's bistreams store, and nothing else holds that raw
# per-connection capture (payload or not) once it's gone; the ES-side
# indices are a separate, already-shorter-retained derived view, not a
# backup of this. Both live readers (payload-dedupe's own hashing pass and
# yara-scanner's YARA_PAYLOAD_ROOTS) only ever need "whatever's currently on
# disk" -- neither one has a forensic requirement for a shorter window, so
# there is no reader-side argument for cutting it either.
#
# Measured 2026-09-03: 163 GB across 26 date directories (was 151 GB/25 dirs
# on 09-02 -- growth has accelerated to roughly 6-11 GB/day, not the ~5 GB/day
# round 4 measured). At that rate the projected steady state is roughly
# 180-330 GB at 30 days and 126-231 GB at 21 days; cutting to 21 would
# delete ~13.4 GB today (the four oldest dirs).
#
# FIRST DELETION: the oldest directory is 2026-08-09 and nothing has ever
# been pruned from this store. At 30 days, prune_old_directories() performs
# the first irreversible deletion in its history on 2026-09-09.
#
# The disk ledger deliberately plays no part in this decision. Every lever
# in the same capacity batch (#2852, #2859, #2882, and this one) ended at
# zero bytes reclaimed and /var got worse over it, so "relief will come from
# elsewhere" would be a claim this value must not rest on. It rests on the
# forensic argument above instead, which stands on its own. Revisit only
# with a forensic reason to shorten it, never because /var is tight.
BISTREAMS_RETENTION_DAYS=30

# optional, defaults to '3600' if unset
PAYLOAD_DEDUPE_INTERVAL=3600

# optional, defaults to '67108864' if unset
YARA_MAX_BYTES=67108864

# optional, defaults to '900' if unset
YARA_SCAN_INTERVAL=900

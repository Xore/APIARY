# /etc/crontab: system-wide crontab
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin

# m h dom mon dow user	command
17 *	* * *	root	cd / && run-parts --report /etc/cron.hourly
25 6	* * *	root	test -x /usr/sbin/anacron || { cd / && run-parts --report /etc/cron.daily; }
0  3	* * *	svc-backup	/opt/nexusai-inference/scripts/backup.sh >> /var/log/portal/backup.log 2>&1
*/5 *	* * *	deploy	/usr/bin/curl -fsS https://monitor.nexusai.local/ping/gpu01 >/dev/null 2>&1
0  4	* * 0	root	/usr/bin/certbot renew --quiet --deploy-hook "systemctl reload nginx"
30 2	* * *	root	/usr/sbin/logrotate /etc/logrotate.conf

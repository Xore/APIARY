# NexusAI Inference Console — production environment
# Managed by CI. Do not edit by hand; changes are overwritten on deploy.
NODE_ENV=production
PORT=3000
APP_URL=https://inference.nexusai.example

# PostgreSQL (db-01)
DATABASE_URL=postgres://inference:DECOY_ONLY_public_example@pg-db-02.nexusai.local:5432/inference
DB_POOL_MAX=20

# Redis (cache-01)
REDIS_URL=redis://cache01.nexusai.local:6379
REDIS_PASSWORD=DECOY_ONLY_public_example

# Auth
JWT_SECRET=DECOY_ONLY_public_example
SESSION_SECRET=DECOY_ONLY_public_example
INFERENCE_API_KEY=DECOY_ONLY_public_example

# SMTP relay
SMTP_HOST=mail01.nexusai.local
SMTP_PORT=587
SMTP_USER=inference-alerts@nexusai.example
SMTP_PASS=DECOY_ONLY_public_example

# Object storage (backups / uploads)
S3_ENDPOINT=https://objects.nexusai.internal
S3_BUCKET=nexusai-inference-prod
S3_ACCESS_KEY=DECOY_ONLY_public_example
S3_SECRET_KEY=DECOY_ONLY_public_example

# Feature flags
FLAG_BATCHING_V2=true
SENTRY_DSN=https://a1b2c3d4e5f60718@errors.nexusai.internal/4

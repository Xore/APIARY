# honeypot-dashboard-backend — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to '' if unset
# The self-hosted Canarytokens platform's frontend, published on the
# WireGuard address only by honeypot-canarytokens' compose --
# http://10.8.0.2:19426 on this fleet. Same reachability posture as
# HONEYFS_IMPLANT_URL below.
#
# Leaving it empty is not neutral: canarytokens::create answers 503
# "canarytoken creation is not configured on this host", and every other
# part of the feature -- the platform, the adapter, the store, the page --
# keeps working, so the dashboard looks healthy while token creation is
# switched off. That is exactly how it shipped (#1487); the platform had
# been up and healthy the whole time.
CANARYTOKENS_API_URL=

# optional, defaults to '' (disabled) if unset — the shared secret this
# service and dashboard-next (in the sibling honeypot-dashboard stack)
# authenticate each other with. Empty disables the check entirely; both
# tiers share the honeynet bridge with every honeypot sensor container,
# so this should be set to a real value before any real deployment, not
# left at the default. Set the identical value here and as
# DASHBOARD_SERVICE_TOKEN in honeypot-dashboard's own env.
DASHBOARD_SERVICE_TOKEN=

# optional, defaults to '' if unset
HONEYFS_IMPLANT_TOKEN=

# optional, defaults to '' if unset
# The honeyfs-implant service, published on the WireGuard address only by
# honeypot-cowrie's compose -- http://10.8.0.2:19428 on this fleet. This
# stack is the one that reads it: the credential API lives here, and with
# this unset every implant returns 503 "not configured" (#1487).
HONEYFS_IMPLANT_URL=

# optional, defaults to '5m' if unset
PAYLOAD_INVENTORY_SCAN_INTERVAL=5m

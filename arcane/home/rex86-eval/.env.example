# rex86-eval environment (#1982: every ${VAR} interpolated in compose.yml
# must be documented here, because this file is what a deployer copies when
# standing the stack up by hand).

# Where the APIARY checkout lives on this host. Mounted at /repo in the
# container; the scoring harness (corpus_eval.py, manifest.json,
# rev_cases_v2_rubric.json) is symlinked from it into /work, so an edit to
# the harness is the same edit everywhere instead of a stale copy.
# On the homeserver this is /mnt-1/benchmarks/APIARY.
APIARY_REPO=/mnt-1/benchmarks/APIARY

# Which GPU to expose. "all" is correct for this single-GPU host; set to a
# device index to share the box with another workload.
NVIDIA_VISIBLE_DEVICES=all

# honeypot-canarytokens — environment overrides for Compose interpolation.
# Copy to .env in this directory (or provide via Arcane's project.env)
# and fill in real values. Do not commit a real .env.

# optional, defaults to 'honeypot.example' if unset -- the bare apex domain
# tokens are issued against. Override with the real deployed domain: the
# whole value of a canarytoken is its hostname, and with the placeholder
# left in place every token's DNS/web trigger silently points at it.
CANARY_PUBLIC_HOSTNAME=honeypot.example

# REQUIRED: set a random seed in .env
CANARY_WG_PRIVATE_KEY_SEED=

# optional, defaults to '10.8.0.2' if unset
HP_BIND=10.8.0.2

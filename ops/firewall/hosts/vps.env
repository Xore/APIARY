# swarm-plane.sh settings for the VPS. NOT APPLIED in phase 0: the VPS is not
# a swarm member yet. Phase 1 (#3589) applies it when the VPS joins as a
# worker over the hub tunnel.

SWARM_ZONE=apiary-swarm
SWARM_MANAGER=0

# Only the hub tunnel. eth0 is public and must never carry the swarm plane.
SWARM_IFACES="wg0"

# homeserver and precision hub addresses.
SWARM_PEERS="10.8.0.2/32 10.8.0.3/32"

LAN_ZONES="public"

# The hub listener 51820/udp is already open in the VPS public zone
# (WireGuard endpoint, public by design); nothing extra here.

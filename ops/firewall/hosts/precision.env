# swarm-plane.sh settings for precision. Sourced as shell.
# Flow reasons live in swarm-plane.sh and docs/SWARM-NETWORK.md (flow matrix).

SWARM_ZONE=apiary-swarm

# Phase 0 (#3588): the direct fibre to homeserver. The 10 Gb uplink
# enp4s0f0 is LAN and must stay out of this zone.
SWARM_IFACES="enp4s0f1"
# Phase 1 (#3589):
#   SWARM_IFACES="enp4s0f1 wg0 wg-fibre wg-lan"

# Phase 0: homeserver's fibre address.
SWARM_PEERS="10.254.250.1/32"
# Phase 1:
#   SWARM_PEERS="10.8.0.0/24"

LAN_ZONES="public"

# Phase 1: WireGuard listeners for the homeserver<->precision tunnels.
#   ACCEPT_RULES="apiary-swarm,10.254.250.1/32,51821,udp public,192.168.42.250/32,51822,udp"
ACCEPT_RULES=""

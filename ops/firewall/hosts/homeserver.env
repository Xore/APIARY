# swarm-plane.sh settings for homeserver (supermicro). Sourced as shell.
# Flow reasons live in swarm-plane.sh and docs/SWARM-NETWORK.md (flow matrix).

# Zone that carries the swarm plane. Default deny, logged.
SWARM_ZONE=apiary-swarm

# Interfaces bound into SWARM_ZONE. Never a LAN or public interface.
# Phase 0 (#3588): the direct fibre to precision, swarm still on 10.254.250.0/30.
SWARM_IFACES="ens9f1"
# Phase 1 (#3589) target: the fibre underlay stays in the zone (it then only
# needs the wg-fibre listener, see ACCEPT_RULES) and the three tunnels join:
#   SWARM_IFACES="ens9f1 wg0 wg-fibre wg-lan"

# Sources allowed to speak the swarm plane (and peer-scoped SSH).
# Phase 0: precision's fibre address.
SWARM_PEERS="10.254.250.2/32"
# Phase 1: every node re-joins on its hub address (10.8.0.x), carried by
# wg0 (VPS), wg-fibre or wg-lan (precision). Drop the /30 after the re-join:
#   SWARM_PEERS="10.8.0.0/24"

# Zones of LAN/public interfaces. They get logged drops for the swarm plane.
# wg0 has no explicit zone today, so it falls into public as well.
LAN_ZONES="public"

# Extra peer-scoped accepts, space separated "zone,source,port,proto".
# Phase 1: WireGuard listeners for the homeserver<->precision tunnels.
#   ACCEPT_RULES="apiary-swarm,10.254.250.2/32,51821,udp public,192.168.42.247/32,51822,udp"
ACCEPT_RULES=""
